{% extends 'partials/base.html.twig' %}

{% set layout_view = 'note' %}

{% block content %}
    <div class="w-full min-h-dvh p-3">
        <div class="h-full overflow-y-auto bg-background">
            <div class="px-2 py-8 text-center">
                <h1 class="note-title text-2xl font-bold mb-4">Error {{ page.header.http_response_code|default(404)|e }}</h1>
                <div class="text-muted-foreground">{{ page.content|raw }}</div>
            </div>
        </div>
    </div>
{% endblock %}
