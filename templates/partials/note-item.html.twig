{# Expects: item (page), current_route, show_divider #}
{% set is_selected = item.route == current_route %}
{% set emoji = item.header.emoji|default(config.theme.default_emoji|default('📝')) %}
{% set text = item.content|striptags|replace({"\r": ' ', "\n": ' ', "\t": ' ', '&nbsp;': ' '})|trim %}
<li class="note-item h-[70px] w-full{{ is_selected ? ' is-selected rounded-md' : '' }}{{ show_divider and not is_selected ? ' note-item-divider' : '' }}"
    data-note-slug="{{ item.slug|e('html_attr') }}"
    data-note-route="{{ item.route|e('html_attr') }}"
    data-note-id="{{ item.id|e('html_attr') }}"
    data-search-text="{{ (item.title ~ ' ' ~ text|slice(0, 500))|lower|e }}">
    <div class="h-full w-full px-4">
        <a href="{{ item.url|e }}" class="py-2 h-full w-full flex flex-col justify-center"{{ is_selected ? ' aria-current="page"' : '' }}>
            <h2 class="text-sm font-bold px-2 break-words line-clamp-1 note-item-title">
                {{ emoji }}
                {{ item.title }}
            </h2>
            <p class="text-xs pl-2 break-words line-clamp-1 note-item-preview">
                <span class="note-item-date">{{ item.date|date('M d, Y') }}</span>
                {{ text|slice(0, 100)|raw }}
            </p>
        </a>
    </div>
</li>
