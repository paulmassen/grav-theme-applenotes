{% set siblings = page.parent ? page.parent.children() : pages.children() %}
{% set notes = siblings.published().routable().nonModular().order('date', 'desc') %}
{# Pages explicitly hidden with `visible: false` in their frontmatter are not listed. #}
{% set notes = notes|filter(note => note.header.visible is not defined or note.header.visible is not same as(false)) %}

{# Group notes like Apple Notes does. Keys must not be numeric: Twig's merge filter renumbers numeric keys. #}
{% set today = 'now'|date('Y-m-d') %}
{% set yesterday = 'now'|date_modify('-1 day')|date('Y-m-d') %}
{% set week_ago = 'now'|date_modify('-7 days')|date('Y-m-d') %}
{% set month_ago = 'now'|date_modify('-30 days')|date('Y-m-d') %}
{% set pinned = [] %}
{% set groups = {today: [], yesterday: [], week: [], month: [], older: []} %}
{% for note in notes %}
    {% if note.header.pinned %}
        {% set pinned = pinned|merge([note]) %}
    {% else %}
        {% set day = note.date|date('Y-m-d') %}
        {% set group = day >= today ? 'today' : (day == yesterday ? 'yesterday' : (day >= week_ago ? 'week' : (day >= month_ago ? 'month' : 'older'))) %}
        {% set groups = groups|merge({(group): groups[group]|merge([note])}) %}
    {% endif %}
{% endfor %}
{% set sections = [
    {title: '📌 Pinned', notes: pinned},
    {title: 'Today', notes: groups.today},
    {title: 'Yesterday', notes: groups.yesterday},
    {title: 'Previous 7 Days', notes: groups.week},
    {title: 'Previous 30 Days', notes: groups.month},
    {title: 'Older', notes: groups.older}
] %}

<aside class="sidebar w-[320px] border-r border-muted-foreground/20 h-dvh flex flex-col dark:bg-muted" id="sidebar">
    <div class="w-[320px]">
        {% include 'partials/nav.html.twig' %}
    </div>
    <div class="flex-1 overflow-y-auto" id="sidebar-scroll">
        <div class="flex flex-col w-full">
            <div class="w-[320px] px-2">
                <div class="p-2">
                    {% include 'partials/search.html.twig' %}
                </div>
                <div class="py-2" id="notes-list">
                    <nav aria-label="Notes">
                        {% for section in sections|filter(section => section.notes|length > 0) %}
                            <section>
                                <h3 class="py-1 text-xs font-bold sidebar-category-title ml-2">{{ section.title }}</h3>
                                <ul>
                                    {% for item in section.notes %}
                                        {% include 'partials/note-item.html.twig' with {
                                            item: item,
                                            current_route: page.route,
                                            show_divider: not loop.last
                                        } %}
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endfor %}
                        <p class="notes-search-empty text-sm text-muted-foreground px-2 mt-4" hidden>No results found</p>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</aside>
