{% set emoji = page.header.emoji|default(config.theme.default_emoji|default('📝')) %}

<header class="px-2 mb-4 relative">
    <div class="flex justify-center items-center">
        <p class="text-muted-foreground text-xs">
            <time datetime="{{ page.date|date('c') }}">{{ page.date|date('F d, Y \\a\\t g:i A') }}</time>
        </p>
        <div class="ml-2 h-6 flex items-center"></div>
    </div>
    <div class="flex items-center relative">
        <span class="mr-2 text-2xl" aria-hidden="true">{{ emoji }}</span>
        <h1 class="note-title text-2xl font-bold flex-grow py-2 leading-normal min-h-[50px]">{{ page.title }}</h1>
    </div>
</header>
